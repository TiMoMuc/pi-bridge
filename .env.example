# See README.md for the full environment-variable guide, examples, and path-model explanation.
# This file matches the current commit. If you are upgrading from an older bridge
# version, compare your existing .env against this file before restarting.

# === Optional Compose project name ===
# COMPOSE_PROJECT_NAME=pi-bridge

# === Host paths (used by Docker Compose; also passed through for sibling-container mounts) ===
# Leave unset for the repo defaults.
# If you set BRIDGE_DATA_HOST_DIR but leave PROJECTS_HOST_DIR unset, Compose derives
# PROJECTS_HOST_DIR as ${BRIDGE_DATA_HOST_DIR}/projects.
# If you set these explicitly, prefer absolute host paths.
# BRIDGE_DATA_HOST_DIR=/absolute/path/to/bridge-data
# PROJECTS_HOST_DIR=/absolute/path/to/projects

# === In-container paths (shared path contract) ===
# BRIDGE_DATA_DIR=/bridge-data
# PROJECTS_DIR=/bridge-data/projects

# === Advanced / dev: non-root host ownership override ===
# Default behavior stays root:root. Leave these unset unless you explicitly want the
# bridge, sandbox, and code-server to write bind-mounted host files as a specific host
# user. Before enabling, stop the bridge and manually chown BRIDGE_DATA_HOST_DIR /
# PROJECTS_HOST_DIR to that uid:gid. BRIDGE_DOCKER_SOCKET_GID must match the numeric
# group that owns /var/run/docker.sock on the host.
# BRIDGE_RUNTIME_UID=1001
# BRIDGE_RUNTIME_GID=1001
# BRIDGE_DOCKER_SOCKET_GID=989

# === Signal transport ===
SIGNAL_PHONE_NUMBER=+15551234567
SIGNAL_CLI_URL=http://localhost:8080

# === Nextcloud transport ===
# NEXTCLOUD_BASE_URL=https://cloud.example.com
# NEXTCLOUD_BOT_SECRET=replace-with-a-long-random-secret
# NEXTCLOUD_WEBHOOK_HOST=0.0.0.0
# NEXTCLOUD_WEBHOOK_PORT=8788
# NEXTCLOUD_WEBHOOK_PATH=/nextcloud-talk-webhook
# NEXTCLOUD_API_USER=bot-user
# NEXTCLOUD_API_PASSWORD=app-password-or-app-token

# === Provider, model, and thinking ===
# PI_CODING_AGENT_DIR=/bridge-data/pi-agent
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-5
PI_THINKING_LEVEL=off       # off | minimal | low | medium | high | xhigh
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# XAI_API_KEY=...
# MISTRAL_API_KEY=...
# OPENROUTER_API_KEY=...

# === Access control ===
BRIDGE_ACCESS_MODE=open
# ADMIN_PHONE=+15559876543

# === Code-server defaults and infrastructure ===
# CODE_SERVER_IMAGE=pi-bridge-code-server:latest
# CODE_SERVER_BIND_HOST=127.0.0.1
# CODE_SERVER_PORT_START=18440
# CODE_SERVER_PUBLIC_URL_TEMPLATE=https://code-{workspaceKey}.example.com/
# CODE_SERVER_EXTENSIONS_MODE=append        # append | override
# CODE_SERVER_EXTENSIONS=ms-vscode.live-server,bierner.markdown-mermaid
# DEFAULT_NEW_WORKSPACE_CODE_SERVER_ENABLED=false

# === Boot preload defaults (written into workspace.json on first provisioning) ===
# DEFAULT_NEW_WORKSPACE_BOOT_ENABLED=true

# === Calendar subscription feeds ===
# DEFAULT_NEW_WORKSPACE_CALENDAR_ENABLED=false
# CALENDAR_ENABLED=true
# CALENDAR_HTTP_HOST=0.0.0.0
# CALENDAR_HTTP_PORT=8789
# CALENDAR_PUBLIC_BASE_URL=https://calendar.example.com
# CALENDAR_REFRESH_INTERVAL=PT15M

# === Session watch ===
# SESSION_WATCH_ENABLED=false
# SESSION_WATCH_HOST=127.0.0.1
# SESSION_WATCH_PORT=8791
# SESSION_WATCH_PUBLIC_BASE_URL=https://watch.example.com

# === Operator admin UI ===
# Enabled only when both ADMIN_UI_USER and ADMIN_UI_PASSWORD are set.
# Docker Compose publishes the port on 127.0.0.1 by default.
# Set ADMIN_UI_PUBLISH_HOST=0.0.0.0 (or a specific LAN IP) if other machines on
# your network should reach the UI directly.
# ADMIN_UI_PUBLISH_HOST=127.0.0.1
# ADMIN_UI_PORT=8792
# ADMIN_UI_USER=operator
# ADMIN_UI_PASSWORD=replace-with-a-long-random-password

# === Sandbox ===
# SANDBOX_IMAGE=pi-bridge-sandbox:latest
# SANDBOX_MEMORY=536870912
# SANDBOX_CPUS=1000000000
# SANDBOX_NETWORK=none
# Relative to the fixed workspace root mounted at /workspace.
# `.` means the workspace root; `./cowork` would start inside cowork/.
# SANDBOX_CWD=.
